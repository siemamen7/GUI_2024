<Page x:Class="WpfApp001.View.GrafikMedicalPageInterface" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GrafikMedicalPageInterface">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Week Selection -->
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Tydzień" FontWeight="Bold" Margin="0,0,0,5" />
            <ListBox x:Name="WeekListBox" SelectionMode="Multiple" MaxHeight="100">
                <ListBoxItem Content="1 - 7.12.2024" />
                <ListBoxItem Content="8 - 14.12.2024" />
                <ListBoxItem Content="15 - 21.12.2024" />
                <!-- Add more weeks as needed -->
            </ListBox>
        </StackPanel>

        <!-- Day Selection -->
        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Dzień" FontWeight="Bold" Margin="0,0,0,5" />
            <ListBox x:Name="DayListBox" SelectionMode="Multiple" MaxHeight="100">
                <ListBoxItem Content="Poniedziałek" />
                <ListBoxItem Content="Wtorek" />
                <ListBoxItem Content="Środa" />
                <ListBoxItem Content="Czwartek" />
                <ListBoxItem Content="Piątek" />
                <ListBoxItem Content="Sobota" />
                <ListBoxItem Content="Niedziela" />
            </ListBox>
        </StackPanel>

        <!-- Hour Selection -->
        <StackPanel Grid.Column="2" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Godziny" FontWeight="Bold" Margin="0,0,0,5" />
            <ListBox x:Name="HourListBox" SelectionMode="Multiple" MaxHeight="100">
                <ListBoxItem Content="7:30" />
                <ListBoxItem Content="8:00" />
                <ListBoxItem Content="8:30" />
                <ListBoxItem Content="9:00" />
                <ListBoxItem Content="9:30" />
                <ListBoxItem Content="10:00" />
                <ListBoxItem Content="10:30" />
                <ListBoxItem Content="11:00" />
                <ListBoxItem Content="11:30" />
                <ListBoxItem Content="12:00" />
                <ListBoxItem Content="12:30" />
                <!-- Add more hours as needed -->
            </ListBox>
        </StackPanel>

        <!-- Search Button -->
        <StackPanel Grid.Column="3" Margin="5" VerticalAlignment="Top">
            <Button x:Name="SearchButton" Content="Szukaj" Width="100" Height="30" Margin="5" />
        </StackPanel>
    </Grid>
</Page>
