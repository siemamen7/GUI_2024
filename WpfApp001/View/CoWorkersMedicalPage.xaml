<Page x:Class="WpfApp001.View.CoWorkersMedicalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CoWorkersMedicalPage">

    <Grid>
        <!-- DataGrid to display employee information -->
        <DataGrid Name="EmployeesDataGrid" AutoGenerateColumns="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <!-- Define columns for the table -->
                <DataGridTextColumn Header="Imię" Binding="{Binding FirstNamse}" Width="*" />
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastNamse}" Width="*" />
                <DataGridTextColumn Header="Funkcja" Binding="{Binding Positison}" Width="*" />
                <DataGridTextColumn Header="Kontakt" Binding="{Binding Contasct}" Width="*" />
                <DataGridTextColumn Header="Informacje" Binding="{Binding AdditionalInsfo}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
