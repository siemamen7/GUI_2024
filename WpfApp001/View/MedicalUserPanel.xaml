<Page x:Class="WpfApp001.View.MedicalUserPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MedicalUserPanel">

    <Grid Background="{StaticResource AmbientBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="307*"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="727*"/>
            <ColumnDefinition Width="64*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <Button Style ="{StaticResource RoundedButtonStyle}" Content="Grafik" Margin=" 10"  Click="OnGrafikButtonClick" />
            <Button Style ="{StaticResource RoundedButtonStyle}" Content="Baza Pacjentów" Margin=" 10" Click="OnBazaPacjentowButtonClick"/>
            <Button Style ="{StaticResource RoundedButtonStyle}" Content="Baza Pracowników" Margin=" 10" Click="OnBazaPracownikowButtonClick"/>
            <Button Style ="{StaticResource RoundedButtonStyle}" Content="Mail" Margin=" 10" Background ="LightBlue" Click="OnMailButtonClick"/>
        </StackPanel>
        <StackPanel/>

        <Button Click="MoveTODO" Grid.Row="0" Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Margin="10,10,10,10">
            <Button.Content>
                <Image Source="pack://application:,,,/WpfApp001;component/Styles/Icons/logout.png" />
            </Button.Content>
        </Button>

        <Frame x:Name="MedicalUserMainFrame" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" >
        </Frame>
        <Frame x:Name="MedicalUserCard" Grid.Row="0" Grid.Column="0" Source="UserCard.xaml">
        </Frame>




    </Grid>
</Page>
