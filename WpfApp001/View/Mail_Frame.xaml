<Page x:Class="WpfApp001.View.Mail_Frame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Mail_Frame">

    <Grid Margin="10">
        <!-- Podział na 3 kolumny: pasek boczny, lista wiadomości, pole do pisania wiadomości -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <!-- Pasek boczny -->
            <ColumnDefinition Width="*" />
            <!-- Lista wiadomości -->
        </Grid.ColumnDefinitions>

        <!-- Pasek boczny - Lista osób -->
        <Border Style="{StaticResource CustomBorderStyle}" BorderBrush="{StaticResource SecondaryLightBrush}" BorderThickness="2" Margin="5" CornerRadius="10">
            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Kontakty" Margin="10" FontSize="16" FontWeight="Bold" />
                <Button Content="Osoba 1" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="5" FontWeight="Bold" Foreground="#FFD0D6D6" />
                <Button Content="Osoba 2" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="5" FontWeight="Bold" Foreground="#FFD0D6D6" />
                <Button Content="Osoba 3" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="5" FontWeight="Bold" Foreground="#FFD0D6D6" />
            </StackPanel>
        </Border>

        <!-- Lista wiadomości -->
        <ListBox Grid.Column="1" Margin="10,10,10,72" Style="{StaticResource CustomListBoxStyle}" >
            
            <ListBoxItem>
                <StackPanel>
                    <TextBlock Text="Osoba 1" FontWeight="Bold" />
                    <TextBlock Text="Cześć, jak się masz?" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel>
                    <TextBlock Text="Osoba 2" FontWeight="Bold" />
                    <TextBlock Text="Wszystko w porządku!" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>
         

      
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal"  Margin="5">
            <TextBox Width="600" Height="40" Margin="5" Style="{StaticResource CustomTextBoxStyle}"/>
            <Button Content="Wyślij" Width="80" Margin="5" VerticalAlignment="Center" Style="{StaticResource CustomSendButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
