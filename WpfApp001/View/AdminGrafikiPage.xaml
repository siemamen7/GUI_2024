<Page x:Class="WpfApp001.View.AdminGrafikiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminGrafikiPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Week Selection -->
            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Tydzień" FontWeight="Bold" Margin="0,0,0,5" />
                <ComboBox x:Name="WeekComboBox" Style="{StaticResource CustomComboBoxStyle}">
                    <ComboBoxItem Content="1 - 7.12.2024" />
                    <ComboBoxItem Content="8 - 14.12.2024" />
                    <ComboBoxItem Content="15 - 21.12.2024" />
                    <ComboBoxItem Content="22 - 28.12.2024" />
                    <ComboBoxItem Content="29 - 04.12.2025" />
                    <ComboBoxItem Content="05 - 11.12.2024" />
                    <!-- Add more weeks as needed -->
                </ComboBox>
            </StackPanel>

            <!-- Day Selection -->
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Dzień" FontWeight="Bold" Margin="0,0,0,5" />
                <ComboBox x:Name="DayComboBox" Style="{StaticResource CustomComboBoxStyle}">
                    <ComboBoxItem Content="Poniedziałek" />
                    <ComboBoxItem Content="Wtorek" />
                    <ComboBoxItem Content="Środa" />
                    <ComboBoxItem Content="Czwartek" />
                    <ComboBoxItem Content="Piątek" />
                    <ComboBoxItem Content="Sobota" />
                    <ComboBoxItem Content="Niedziela" />
                </ComboBox>
            </StackPanel>

            <!-- Hour Selection -->
            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Godziny" FontWeight="Bold" Margin="0,0,0,5" />
                <ComboBox x:Name="HourComboBox" Style="{StaticResource CustomComboBoxStyle}">
                    <ComboBoxItem Content="7:30" />
                    <ComboBoxItem Content="8:00" />
                    <ComboBoxItem Content="8:30" />
                    <ComboBoxItem Content="9:00" />
                    <ComboBoxItem Content="9:30" />
                    <ComboBoxItem Content="10:00" />
                    <ComboBoxItem Content="10:30" />
                    <ComboBoxItem Content="11:00" />
                    <ComboBoxItem Content="11:30" />
                    <ComboBoxItem Content="12:00" />
                    <ComboBoxItem Content="12:30" />
                    <!-- Add more hours as needed -->
                </ComboBox>
            </StackPanel>

            <!-- Search Button -->
            <StackPanel Grid.Column="3" Margin="5" VerticalAlignment="Top">
                <Button Style="{StaticResource CustomSendButtonStyle}" x:Name="SearchButton" Content="Szukaj" Width="100" Height="30" Margin="5" />
            </StackPanel>
        </Grid>


        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredEvents}"
                  x:Name="TimetableGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  HeadersVisibility="All" 
                  Margin="10">
            <DataGrid.Columns>
                <!-- Time Column -->
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Day Columns -->
                <DataGridTextColumn Header="Monday" Binding="{Binding Monday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Tuesday" Binding="{Binding Tuesday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Wednesday" Binding="{Binding Wednesday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Thursday" Binding="{Binding Thursday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Friday" Binding="{Binding Friday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Saturday" Binding="{Binding Saturday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Sunday" Binding="{Binding Sunday}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
