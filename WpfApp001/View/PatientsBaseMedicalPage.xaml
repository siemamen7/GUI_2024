<Page x:Class="WpfApp001.View.PatientsBaseMedicalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PatientsBaseMedicalPage">

    <Grid>
        <DataGrid x:Name="dataGrid" AutoGenerateColumns="False">
            <!-- Kolumna Imię -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="*"/>
                <!-- Kolumna Nazwisko -->
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="*"/>
                <!-- Kolumna PESEL -->
                <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel}" Width="*"/>
                <!-- Kolumna Data urodzenia -->
                <DataGridTextColumn Header="Data urodzenia" Binding="{Binding DataUrodzenia}" Width="*" />
                <!-- Kolumna Informacje z przewijaniem -->
                <DataGridTemplateColumn Header="Informacje">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="100">
                                <TextBox Text="{Binding Informacje}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="False" />
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>