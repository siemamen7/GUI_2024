<Page x:Class="WpfApp001.View.AdminInterfaceGrafiki"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminInterfaceGrafiki">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Week Selection -->
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Tydzień" FontWeight="Bold" Margin="0,0,0,5" />
            <ComboBox x:Name="WeekComboBox" Style="{StaticResource CustomComboBoxStyle}">
                <ComboBoxItem Content="1 - 7.12.2024" />
                <ComboBoxItem Content="8 - 14.12.2024" />
                <ComboBoxItem Content="15 - 21.12.2024" />
                <!-- Add more weeks as needed -->
            </ComboBox>
        </StackPanel>

        <!-- Day Selection -->
        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Dzień" FontWeight="Bold" Margin="0,0,0,5" />
            <ComboBox x:Name="DayComboBox" Style="{StaticResource CustomComboBoxStyle}">
                <ComboBoxItem Content="Poniedziałek" />
                <ComboBoxItem Content="Wtorek" />
                <ComboBoxItem Content="Środa" />
                <ComboBoxItem Content="Czwartek" />
                <ComboBoxItem Content="Piątek" />
                <ComboBoxItem Content="Sobota" />
                <ComboBoxItem Content="Niedziela" />
            </ComboBox>
        </StackPanel>

        <!-- Hour Selection -->
        <StackPanel Grid.Column="2" Margin="5">
            <TextBlock Style="{StaticResource GlobalTextBlockStyle}" Text="Godziny" FontWeight="Bold" Margin="0,0,0,5" />
            <ComboBox x:Name="HourComboBox" Style="{StaticResource CustomComboBoxStyle}">
                <ComboBoxItem Content="7:30" />
                <ComboBoxItem Content="8:00" />
                <ComboBoxItem Content="8:30" />
                <ComboBoxItem Content="9:00" />
                <ComboBoxItem Content="9:30" />
                <ComboBoxItem Content="10:00" />
                <ComboBoxItem Content="10:30" />
                <ComboBoxItem Content="11:00" />
                <ComboBoxItem Content="11:30" />
                <ComboBoxItem Content="12:00" />
                <ComboBoxItem Content="12:30" />
                <!-- Add more hours as needed -->
            </ComboBox>
        </StackPanel>

        <!-- Search Button -->
        <StackPanel Grid.Column="3" Margin="5" VerticalAlignment="Top">
            <Button Style="{StaticResource CustomSendButtonStyle}" x:Name="SearchButton" Content="Szukaj" Width="100" Height="30" Margin="5" />
        </StackPanel>
    </Grid>
</Page>
