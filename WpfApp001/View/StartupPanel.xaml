<Page x:Class="WpfApp001.View.StartupPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="StartupPanel">

    <Grid>
        <Grid Background="{StaticResource AmbientBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="66*"/>
                <RowDefinition Height="342*"/>
                <RowDefinition Height="251*"/>
            </Grid.RowDefinitions>

            <!-- Return Button -->
            <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedButtonStyle}" Margin="10,10,10,10">
                <Button.Content>
                    <Image Source="pack://application:,,,/WpfApp001;component/Styles/Icons/logout.png" />
                </Button.Content>
            </Button>

            <!-- Content for the first column -->
            <Button  Style ="{StaticResource RoundedButtonStyle}"  Grid.Column="1" Grid.Row="1" Content="Panel użytkownika"  Margin="10,10,10,10" Click="MoveTODO" Command="{Binding UserPanelCommand}"/>

            <!-- Content for the second column -->
            <Button Style ="{StaticResource RoundedButtonStyle}" Grid.Column="3" Grid.Row="1" Content="Panel administratora" Margin="10,10,10,10" Click="MoveTODO" Command="{Binding AdminPanelCommand}"/>

            <!-- Image in Column 1, Row 2 -->
            <Image Grid.Column="1" Grid.Row="2" 
           Source="pack://application:,,,/WpfApp001;component/Styles/Icons/stethoscope.png" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Margin="10"/>


            <Image Grid.Column="3" Grid.Row="2" 
           Source="pack://application:,,,/WpfApp001;component/Styles/Icons/workplace.png" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Margin="10"/>


        </Grid>
        
    </Grid>
</Page>
