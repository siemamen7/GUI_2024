<Page x:Class="WpfApp001.View.StartupPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="StartupPanel">

    <Grid>
        <Grid Background="{StaticResource AmbientBackground}">
            <!-- Column and Row Definitions -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <!-- Spacer between buttons -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bigger User Panel Button -->
            <Button Style="{StaticResource RoundedButtonStyle}" Grid.Column="1" Grid.Row="1" Margin="10" Click="MoveToUser" Command="{Binding UserPanelCommand}"
                    Width="350" Height="350">
                <!-- Increased size -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bigger Image Centered -->
                    <Image Source="pack://application:,,,/WpfApp001;component/Styles/Icons/stethoscope.png" 
                           Width="200" Height="200" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Grid.Row="0" />

                    <!-- Text at Middle Bottom -->
                    <TextBlock Text="Panel użytkownika" FontSize="26" HorizontalAlignment="Center" 
                               VerticalAlignment="Bottom" Margin="0,10,0,10" Grid.Row="1"/>
                </Grid>
            </Button>

            <!-- Bigger Admin Panel Button -->
            <Button Style="{StaticResource RoundedButtonStyle}" Grid.Column="3" Grid.Row="1" Margin="10" Click="MoveToAdmin" Command="{Binding AdminPanelCommand}"
                    Width="350" Height="350">
                <!-- Increased size -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bigger Image Centered -->
                    <Image Source="pack://application:,,,/WpfApp001;component/Styles/Icons/workplace.png" 
                           Width="200" Height="200" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Grid.Row="0" />

                    <!-- Text at Middle Bottom -->
                    <TextBlock Text="Panel administratora" FontSize="26" HorizontalAlignment="Center" 
                               VerticalAlignment="Bottom" Margin="0,10,0,10" Grid.Row="1"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Page>