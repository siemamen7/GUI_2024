<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="DarkColor">#222831</Color>
    <Color x:Key="SecondaryDarkColor">#393E46</Color>
    <Color x:Key="AccentColor">#00ADB5</Color>
    <Color x:Key="LightColor">#EEEEEE</Color>

    <!-- SolidColorBrushes for usage in styles -->
    <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource DarkColor}" />
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="LightBrush" Color="{StaticResource LightColor}" />

    <!-- Startup background -->
    <LinearGradientBrush x:Key="AmbientBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource LightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
    </LinearGradientBrush>

    <Style x:Key="RoundedButtonStyle" TargetType="Button">
        <!-- Existing Setters -->
        <Setter Property="Background" Value="{StaticResource LightBrush}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Padding" Value="30,30" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryDarkBrush}" />
        <Setter Property="BorderThickness" Value="3" />

        <!-- Add a ControlTemplate for the rounded appearance -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <Border.Effect>
                            <!-- Default shadow (no effect initially) -->
                            <DropShadowEffect ShadowDepth="0" BlurRadius="0" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="5" BlurRadius="10" Color="Gray" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Click effect -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
    
    
</ResourceDictionary>
