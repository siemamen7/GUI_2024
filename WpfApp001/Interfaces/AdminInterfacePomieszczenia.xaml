<Page x:Class="WpfApp001.View.AdminInterfacePomieszczenia"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp001.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminInterfacePomieszczenia">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- First Name Field -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
            <Label Content="Imię" HorizontalAlignment="Center" Margin="5" FontSize="16" Foreground="#d0d6d6"/>
            <TextBox Style="{StaticResource CustomTextBoxStyle}" Name="FirstNameTextBox" Width="200" Margin="5" FontSize="22"/>
        </StackPanel>

        <!-- Last Name Field -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <Label Content="Nazwisko" HorizontalAlignment="Center" Margin="5" FontSize="16" Foreground="#d0d6d6"/>
            <TextBox Style="{StaticResource CustomTextBoxStyle}" Name="LastNameTextBox" Width="200" Margin="5" FontSize="22"/>
        </StackPanel>

        <!-- PESEL Field -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Left">
            <Label Content="PESEL" HorizontalAlignment="Center" Margin="5" FontSize="16" Foreground="#d0d6d6"/>
            <TextBox Style="{StaticResource CustomTextBoxStyle}" Name="PeselTextBox" Width="200" Margin="5" FontSize="22"/>
        </StackPanel>

        <!-- Search Button -->
        <Button Style="{StaticResource CustomSendButtonStyle}" Grid.Column="3" Content="Szukaj" Width="100" Margin="5,21,5,0" VerticalAlignment="Top" Height="58"/>
        <Button Style="{StaticResource CustomSendButtonStyle}" Grid.Column="3" Content="Modyfikuj" Width="100" Margin="5,91,5,0" VerticalAlignment="Top" Height="58"/>
    </Grid>
</Page>
